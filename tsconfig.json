{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "exclude": ["node_modules", "build", "dist"]
}
